# Public Supabase project settings. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only: needed by /api/account for verified self-service deletion.
# Never use a NEXT_PUBLIC prefix for this privileged key.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY

# Enable only after Google OAuth is configured and its callback is verified.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google OAuth Client ID and Client Secret belong in the Supabase dashboard,
# never in this file or another NEXT_PUBLIC variable. See AUTH_SETUP.md.
