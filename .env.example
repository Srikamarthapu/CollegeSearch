# Public Supabase project settings. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only: needed by /api/account for verified self-service deletion.
# Never use a NEXT_PUBLIC prefix for this privileged key.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY

# Enable only after Google OAuth is configured and its callback is verified.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google OAuth Client ID and Client Secret belong in the Supabase dashboard,
# never in this file or another NEXT_PUBLIC variable. See AUTH_SETUP.md.

# NVIDIA is server-only and OFF by default. A free API Catalog key is for
# internal evaluation, not permission to serve real users. See
# docs/expansion/NVIDIA_EVALUATION_PLAN.md before enabling production.
NVIDIA_API_KEY=
NVIDIA_MODE=disabled
NVIDIA_PRODUCTION_AUTHORIZED=false
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Pin reviewed model version labels after evaluation and before indexing.
NVIDIA_CHAT_MODEL_VERSION=unversioned-provider-alias
NVIDIA_EMBEDDING_MODEL_VERSION=unversioned-provider-alias
ADVISER_EVALUATION_PASSED=false
# Set measured, affordable free limits after live evaluation; blank disables AI.
ADVISER_MONTHLY_ALLOWANCE=
ADVISER_GLOBAL_MONTHLY_ATTEMPTS=
# Random server-only secret (at least 32 characters) for the nightly history purge.
CRON_SECRET=
