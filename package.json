{
  "name": "college-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:verify-overlays": "node scripts/verify-institution-overlays.mjs",
    "data:verify-offline": "node scripts/verify-institution-overlays.mjs --offline && node --test tests/institution-overlays.test.mjs tests/institution-overlay-regressions.test.mjs tests/data-refresh-validation.test.mjs",
    "data:refresh": "node scripts/refresh-data.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "lenis": "1.3.25",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "fflate": "^0.8.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.1",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
